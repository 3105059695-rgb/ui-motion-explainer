    "reveal": "axis x/y clips the logical viewport and moves a cover band using existing occlusionReveal math"
  },
  "scope": "Five parameterized authored expressions plus one explicit retained-design adapter. Other catalog items remain references or source adapters until separately implemented.",
  "capabilities": [
    {
      "id": "material-focus",
      "label": "材料展开、局部聚焦与收至证据区",
      "semantic_use": "先展示真实材料，再放大与本句口播有关的局部，最后保留为旁证，可与结果或步骤事件叠放。",
      "relations": [
        "evidence",
        "focus",
        "handoff"
      ],
      "parameters": {
        "asset": "本期asset ID",
        "crop": "可选，素材像素 x/y/w/h",
        "focusCrop": "可选，素材像素局部",
        "frameRect": "1200×650事件逻辑坐标",
        "dockRect": "可选，1200×650事件逻辑坐标",
        "cues": "focus/return(optional)/dock: event-local seconds; return restores the initial media crop",
        "camera": "{from?:rect,to:rect,at?,duration?,returnAt?,returnDuration?}; internal logical pixels",
        "reveal": "{axis:'x'|'y',at?,duration?,bandSize?,bandColor?}; actual Canvas clip and cover band"
      },
      "example": {
        "at": 0,
        "end": 8,
        "rect": {
          "x": 60,
          "y": 80,
          "w": 1800,
          "h": 900
        },
        "transition": 0.7,
        "id": "minutes-proof",
        "type": "material-focus",
        "title": "把会议纪要里的行动找出来",
        "asset": "minutes",
        "focusCrop": {
          "x": 90,
          "y": 180,
          "w": 960,
          "h": 620
        },
        "dockRect": {
          "x": 24,
          "y": 175,
          "w": 400,
          "h": 300
        },
        "caption": "本期演示纪要",
        "cues": {
          "focus": 2,
          "dock": 5
        }
      },
      "source_provenance": [
        {
          "path": "assets/agent-editorial/source/body-b.js",
