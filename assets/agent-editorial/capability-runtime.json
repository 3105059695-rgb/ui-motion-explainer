  "source_path_base": "skill-root",
  "coordinate_system": {
    "rect": "Canvas absolute pixels",
    "internal": "1200 x 650 logical pixels within event.rect",
    "crop": "Source media pixels",
    "time": "event.at/end: scene-local seconds; cues: event-local seconds",
    "presenter": "regions/protectedRects and overlay.rect are canvas pixels; nested overlay time is presenter-event-local",
