[
  {
    "start": 0.0,
    "end": 1.72,
    "text": "GPT-6根本没那么强"
  },
  {
    "start": 1.72,
    "end": 3.1,
    "text": "我试着给他三个视频"
  },
  {
    "start": 3.1,
    "end": 6.76,
    "text": "希望Astra能够提取里面与内容无关的创作技巧"
  },
  {
    "start": 6.76,
    "end": 9.12,
    "text": "Astra煞有其事地写下了几百字"
  },
  {
    "start": 9.12,
    "end": 11.92,
    "text": "但是当我给一个新的脚本让他做MG动画"
  },
  {
    "start": 11.92,
    "end": 13.52,
    "text": "Another AI Slop"
  },
  {
    "start": 13.52,
    "end": 15.78,
    "text": "但Astra的复刻能力堪称逆天"
  },
  {
    "start": 15.78,
    "end": 18.38,
    "text": "不仅是2D哪怕是3D的Motion Graphics"
  },
  {
    "start": 18.38,
    "end": 20.02,
    "text": "他都能复刻得七七八八"
  },
  {
    "start": 20.02,
    "end": 21.82,
    "text": "于是一个直观的想法"
  },
  {
    "start": 21.82,
    "end": 22.66,
    "text": "诞生了"
  },
  {
    "start": 22.66,
    "end": 24.34,
    "text": "我们可以根据文案脚本"
  },
  {
    "start": 24.34,
    "end": 26.36,
    "text": "先找个差不多的高质量动效视频"
  },
  {
    "start": 26.36,
    "end": 28.44,
    "text": "让Astra用Remotion复刻"
  },
  {
    "start": 28.44,
    "end": 30.86,
    "text": "在Vibe Coding替换成你自己的内容"
  },
  {
    "start": 30.86,
    "end": 33.08,
    "text": "这个过程我称之为Remix"
  },
  {
    "start": 33.08,
    "end": 35.26,
    "text": "比如这段动画上面是原视频"
  },
  {
    "start": 35.26,
    "end": 37.56,
    "text": "下面是Remix出来的视频"
  },
  {
    "start": 37.56,
    "end": 41.0,
    "text": "可以看到我把钱包都换成了AI企业的Logo"
  },
  {
    "start": 41.0,
    "end": 43.26,
    "text": "但Remix中存在两个难点"
  },
  {
    "start": 43.26,
    "end": 45.7,
    "text": "一个是高质量动效视频其实不好找"
  },
  {
    "start": 45.7,
    "end": 48.08,
    "text": "第二个是Remix中复刻这个步骤"
  },
  {
    "start": 48.08,
    "end": 50.08,
    "text": "实际上会消耗非常多的Tokens"
  },
  {
    "start": 50.08,
    "end": 53.32,
    "text": "于是同时Vibe Coding修改只需要很少Tokens"
  },
  {
    "start": 53.32,
    "end": 55.54,
    "text": "然而为了达到最好的复刻效果"
  },
  {
    "start": 55.54,
    "end": 57.3,
    "text": "还是得用上昂贵的GPT-6"
  },
  {
    "start": 57.3,
    "end": 58.06,
    "text": "Astra"
  },
  {
    "start": 58.06,
    "end": 62.3,
    "text": "但Astra每百万Tokens的成本比5.6Sol贵了整整2.5倍"
  },
  {
    "start": 62.3,
    "end": 65.4,
    "text": "Plus用户的5小时额度根本做不了什么"
  },
  {
    "start": 65.4,
    "end": 66.86,
    "text": "为了解决这个问题"
  },
  {
    "start": 66.86,
    "end": 68.72,
    "text": "猫学长构建了Motion Face"
  },
  {
    "start": 68.72,
    "end": 70.66,
    "text": "一人复刻万人共享"
  },
  {
    "start": 70.66,
    "end": 72.62,
    "text": "和传统的Vibe Motion不同点在于"
  },
  {
    "start": 72.62,
    "end": 75.02,
    "text": "它跳过了最耗词元的复刻过程"
  },
  {
    "start": 75.02,
    "end": 76.8,
    "text": "当你需要找动效参考时"
  },
  {
    "start": 76.8,
    "end": 80.12,
    "text": "在广场上点开一个心仪的动效参考视频"
  },
  {
    "start": 80.12,
    "end": 83.04,
    "text": "用Face 解锁它背后绑定的GitHub仓库"
  },
  {
    "start": 83.04,
    "end": 85.84,
    "text": "这就是该视频被复刻出的代码工程"
  },
  {
    "start": 85.84,
    "end": 87.52,
    "text": "你只需要复制URL"
  },
  {
    "start": 87.52,
    "end": 88.68,
    "text": "再和AI说"
  },
  {
    "start": 88.68,
    "end": 90.14,
    "text": "改成自己的内容"
  },
  {
    "start": 90.14,
    "end": 94.84,
    "text": "做出来的动效视频就能继承原视频的画面风格和动效质感"
  },
  {
    "start": 96.22,
    "end": 98.94,
    "text": "和那些塞满平庸动效的Remotion站点不同"
  },
  {
    "start": 98.94,
    "end": 100.88,
    "text": "Motion Face只保有高质量动效"
  },
  {
    "start": 100.88,
    "end": 104.34,
    "text": "使用它们你才能在高度竞争的数字内容生态中"
  },
  {
    "start": 104.34,
    "end": 105.24,
    "text": "脱颖而出"
  },
  {
    "start": 105.24,
    "end": 107.5,
    "text": "核心就是通过真实人类反馈"
  },
  {
    "start": 107.5,
    "end": 110.22,
    "text": "无人问津的动效和代码会被逐步清退"
  },
  {
    "start": 110.22,
    "end": 113.36,
    "text": "高赞的动效代码及复刻人会持续获得Face"
  },
  {
    "start": 113.92,
    "end": 115.22,
    "text": "作为社区发起人"
  },
  {
    "start": 115.22,
    "end": 118.06,
    "text": "猫学长当前以及后续所有视频的动效代码"
  },
  {
    "start": 118.06,
    "end": 119.98,
    "text": "都会上传至Motion Face"
  },
  {
    "start": 119.98,
    "end": 121.8,
    "text": "你可以借鉴和Remix"
  },
  {
    "start": 121.8,
    "end": 123.02,
    "text": "最后我想说"
  },
  {
    "start": 123.02,
    "end": 125.08,
    "text": "大模型确实越来越聪明了"
  },
  {
    "start": 125.08,
    "end": 127.62,
    "text": "但词元的价格似乎也越来越贵"
  },
  {
    "start": 127.62,
    "end": 129.42,
    "text": "后续我们应该考虑的是"
  },
  {
    "start": 129.42,
    "end": 132.18,
    "text": "AI算力不应该只是一次性消费品"
  },
  {
    "start": 132.18,
    "end": 134.06,
    "text": "甚至奢侈品"
  },
  {
    "start": 134.06,
    "end": 137.58,
    "text": "而Motion Face将尝试词元共享的新模式"
  },
  {
    "start": 138.01999999999998,
    "end": 140.3,
    "text": "for socialism!"
  }
]
