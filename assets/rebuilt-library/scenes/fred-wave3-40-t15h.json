      "scenes": [
        {
          "audio": "A high-pitched digital chime sound effect occurs as the scene begins.",
          "label": "Opening Hook",
          "visual": "A static wide shot of a clean, minimalist digital interface. A white background contains a comparative table with three columns and six rows. The lighting is perfectly flat and digital. A yellow and blue graphic logo is positioned in the top right corner. The columns are currently empty of data markers.",
          "shot_type": "Wide Shot",
          "scene_number": 1,
          "timestamp_end": "0:01",
          "timestamp_start": "0:00"
        },
        {
          "audio": "A sequence of four rapid 'pop' or 'click' sound effects, synced to the appearance of each data point.",
          "label": "Product Information",
          "visual": "Data points populate the first column. Checkmarks appear in the first and third rows, while 'X' marks appear in the second and fourth. Numerical data appears in the bottom two rows. The camera remains static. The color palette is strictly monochrome (black, white, grey).",
          "shot_type": "Wide Shot",
          "scene_number": 2,
          "timestamp_end": "0:02",
          "timestamp_start": "0:01"
        },
        {
          "audio": "A second sequence of rapid 'pop' sound effects, mirroring the speed of the data filling the second column.",
          "label": "Product Selling Points",
          "visual": "Data points populate the second column. Checkmarks appear in the first, second, and fourth rows, with an 'X' in the third. The bottom rows fill with numbers. The lighting and background remain consistent and static.",
          "shot_type": "Wide Shot",
          "scene_number": 3,
          "timestamp_end": "0:03",
          "timestamp_start": "0:02"
        },
        {
          "audio": "A third sequence of rapid 'pop' sound effects accompanying the visual data entry.",
          "label": "Product Selling Points",
          "visual": "Data points populate the third and final column. 'X' marks appear in the first and third rows, while checkmarks fill the second and fourth. The final numerical totals appear at the bottom. The visual style is uniform across all columns.",
          "shot_type": "Wide Shot",
          "scene_number": 4,
          "timestamp_end": "0:04",
          "timestamp_start": "0:03"
        },
        {
          "audio": "A sharp 'ding' sound effect, like a bell or notification, sounds as the highlights appear, followed by silence.",
          "label": "Call to Action",
          "visual": "The camera performs a sharp digital zoom into the second column. A dark grey circular highlight appears around the header of the middle column, and a pinkish-red square highlight appears around a specific data point in the fifth row of that same column. The rest of the table is slightly dimmed to emphasize the selection.",
          "shot_type": "Medium Shot",
          "scene_number": 5,
