      "scenes": [
        {
          "audio": "For example, make a vintage music player, in one sentence.",
          "label": "Opening Hook",
          "visual": "Static screenshot of a digital music interface with a black background. The interface features 'RB-338' branding in the top left, a red digital tempo display showing 132.8 BPM, and various glowing buttons in red and yellow. The lighting is artificial, emanating from the software UI elements. The color palette is dominated by black, neon red, and orange highlights.",
          "shot_type": "Close-Up",
          "scene_number": 1,
          "timestamp_end": "0:02",
          "timestamp_start": "0:00"
        },
        {
          "audio": "Just like this one.",
          "label": "Product Information",
          "visual": "The digital interface updates to show a change in the tempo display to 135.8 BPM and the 'RUN / STOP' button shifts from red to green. The UI remains centered in a dark, flat environment with high contrast.",
          "shot_type": "Close-Up",
          "scene_number": 2,
          "timestamp_end": "0:03",
          "timestamp_start": "0:02"
        },
        {
          "audio": "It can make sounds, it can be played.",
          "label": "Product Selling Points",
          "visual": "A transition to a different software module labeled 'TR-808 RHYTHM COMPOSER'. This view shows rows of orange and yellow sliders and a bottom row of 16 numbered square buttons in red and orange. The shot is static and perfectly centered.",
          "shot_type": "Close-Up",
          "scene_number": 3,
          "timestamp_end": "0:05",
          "timestamp_start": "0:03"
        },
        {
          "audio": "Both the interface and the drum machine can produce sound.",
          "label": "Usage Scenarios",
          "visual": "The software interface shrinks and moves to the left side of a clean white digital canvas. A dashed horizontal line appears to the right of the interface, representing a timeline or a gap between stages. The lighting is even and flat throughout the white space.",
          "shot_type": "Wide Shot",
          "scene_number": 4,
          "timestamp_end": "0:07",
          "timestamp_start": "0:05"
        },
        {
          "audio": "But it is still a long way from a truly useful piece of software.",
          "label": "Problem Solving",
          "visual": "The camera remains static on the white environment. A blue and gray label appears on the dashed line, indicating a distance or gap. The software interface remains pinned to the left, and a new destination point is established on the right end of the dashed line.",
          "shot_type": "Wide Shot",
          "scene_number": 5,
          "timestamp_end": "0:08",
          "timestamp_start": "0:07"
        }
      ]
    },
