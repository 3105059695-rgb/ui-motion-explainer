      "scenes": [
        {
          "audio": "But most of the time AI only needs text and structure.",
          "label": "Opening Hook",
          "visual": "A split screen layout with a white background. On the left, a digital interface shows a website layout with text about software. On the right, a dark window displays complex HTML source code. The camera is static. The lighting is digital and even with high contrast between the dark code window and light website window. The color palette is dominated by dark blue, white, and yellow accents.",
          "shot_type": "Medium Shot",
          "scene_number": 1,
          "timestamp_end": "0:02",
          "timestamp_start": "0:00"
        },
        {
          "audio": "So Moli first reads the content to the AI.",
          "label": "Product Information",
          "visual": "The screen transitions to a workflow diagram. A window on the left displays source code. An arrow points to a central black rounded square with a white star icon labeled 'AI'. Below the arrow, another smaller label appears with a logo. Small blocks of text and a 'GET STARTED' button move from the code window toward the AI icon. The background is white and the animation is smooth and linear.",
          "shot_type": "Medium Shot",
          "scene_number": 2,
          "timestamp_end": "0:05",
          "timestamp_start": "0:02"
        },
        {
          "audio": "When a screenshot is really needed or a certain position needs to be clicked,",
