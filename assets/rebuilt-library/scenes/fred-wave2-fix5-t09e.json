      "scenes": [
        {
          "audio": "A single digital 'click' sound effect followed by a short, upbeat transition chime.",
          "label": "Opening Hook",
          "visual": "A white digital interface screen displays four rectangular image cards. The first card shows an orange phoenix illustration, the second a floating palace in the clouds, the third a gold and white abstract sculpture, and the fourth a traditional Chinese water town. A black mouse cursor hovers over the phoenix card. The lighting is bright and even, simulating a computer monitor glow.",
          "shot_type": "Wide Shot",
          "scene_number": 1,
          "timestamp_end": "0:01",
          "timestamp_start": "0:00"
        },
        {
          "audio": "A rapid digital 'whoosh' sound effect.",
          "label": "Product Information",
          "visual": "The interface zooms into the first card. The screen now shows a detailed illustration of a mythical phoenix with golden and orange plumage against a grey background. Smaller detail shots of the phoenix's head and feathers are visible on the right side of the frame. A cursor clicks a small navigation thumbnail at the bottom.",
          "shot_type": "Close-Up",
          "scene_number": 2,
          "timestamp_end": "0:02",
          "timestamp_start": "0:01"
        },
        {
          "audio": "A digital 'click' sound effect.",
          "label": "Product Selling Points",
          "visual": "The screen transitions to the second image: a wide, cinematic landscape of a marble palace platform floating above a sea of clouds with jagged mountain peaks in the background. The color palette is cool blues and bright whites. The cursor moves to the next thumbnail at the bottom.",
          "shot_type": "Close-Up",
          "scene_number": 3,
          "timestamp_end": "0:03",
          "timestamp_start": "0:02"
        },
        {
          "audio": "A digital 'click' sound effect.",
          "label": "Usage Scenarios",
          "visual": "The screen transitions to the third image: an abstract, modern sculpture made of white organic shapes with gold-lined edges, sitting on a dark reflective pedestal. The lighting features soft highlights on the sculpture's curves. The cursor moves toward the center of the screen.",
          "shot_type": "Close-Up",
          "scene_number": 4,
          "timestamp_end": "0:04",
          "timestamp_start": "0:03"
        },
        {
          "audio": "A final high-pitched digital chime that fades out quickly.",
          "label": "Call to Action",
