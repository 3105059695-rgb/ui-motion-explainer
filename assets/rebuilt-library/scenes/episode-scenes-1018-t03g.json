      "scenes": [
        {
          "audio": "So how do we do it?",
          "label": "Opening Hook",
          "visual": "A clean white background featuring a purple circle on the left and a rounded black rectangle on the right. Both elements have soft drop shadows. The camera is static. No characters are present. The lighting is bright and even across the digital canvas with high-key flat tones.",
          "shot_type": "Wide Shot",
          "scene_number": 1,
          "timestamp_end": "0:01",
          "timestamp_start": "0:00"
        },
        {
          "audio": "We download the model.",
          "label": "Product Information",
          "visual": "The camera remains static. A rounded white square card pops into the center of the frame featuring a document icon with a purple downward arrow. The elements from the previous scene shift to the top left. The color palette remains white, black, and purple with minimalist flat design.",
          "shot_type": "Medium Shot",
          "scene_number": 2,
          "timestamp_end": "0:02",
          "timestamp_start": "0:01"
        },
        {
          "audio": "Put it on a machine...",
          "label": "Usage Scenarios",
          "visual": "The first card shifts to the left. A second white card appears to its right, connected by a small black arrow. This second card features a stack of three horizontal server icons. The background remains white and the camera is static.",
          "shot_type": "Wide Shot",
          "scene_number": 3,
          "timestamp_end": "0:03",
          "timestamp_start": "0:02"
        },
        {
          "audio": "...and get it running.",
          "label": "Usage Scenarios",
          "visual": "A third white card appears to the right of the second card, connected by another black arrow. This card features a single server icon with a green light indicator. All three cards are now visible in a linear horizontal row against the white background.",
          "shot_type": "Wide Shot",
          "scene_number": 4,
          "timestamp_end": "0:04",
          "timestamp_start": "0:03"
        },
        {
          "audio": "This is what we call deployment.",
          "label": "Call to Action",
          "visual": "The background cards blur slightly as a large, rounded black rectangle zooms into the center of the frame. The design is bold with high contrast. No characters or physical movements occur; this is a purely graphic animation sequence.",
