          "scene_number": 1,
          "timestamp_end": "0:01",
          "timestamp_start": "0:00"
        },
        {
          "audio": "A crisp digital 'click' sound effect coincides with the selection of the color.",
          "label": "Usage Scenarios",
          "visual": "The camera zooms in on the 'Colors' section of the interface. A series of circular color swatches are displayed. A cursor clicks on a pink swatch, which then becomes highlighted with a dark border. The color palette is vibrant, featuring blue, yellow, pink, and green tones against a white background.",
          "shot_type": "Close-Up",
          "scene_number": 2,
          "timestamp_end": "0:02",
          "timestamp_start": "0:01"
        },
        {
          "audio": "A playful, short synthesized 'bloop' sound plays as the character is selected.",
          "label": "Usage Scenarios",
          "visual": "The camera pans down to the 'Characters' and 'Virtual Pets' section. The cursor selects a small blue water-droplet-like character from a row of diverse icons including a smiling face, a blue creature, a fire spirit, a monkey, and an owl. The selected icon is highlighted with a gray rounded square.",
          "shot_type": "Medium Shot",
          "scene_number": 3,
          "timestamp_end": "0:03",
          "timestamp_start": "0:02"
        },
        {
          "audio": "A subtle mechanical keyboard click sound effect.",
          "label": "Usage Scenarios",
          "visual": "The camera shifts focus to the right-side preview card. It shows the name 'Fred' above a large white ring icon. The cursor moves down to a dark, rounded button at the bottom of the card, preparing to save the configuration. The background of the preview card is slightly translucent.",
          "shot_type": "Close-Up",
          "scene_number": 4,
          "timestamp_end": "0:04",
          "timestamp_start": "0:03"
        },
        {
          "audio": "A final melodic three-note chime plays, increasing in pitch to signal completion.",
