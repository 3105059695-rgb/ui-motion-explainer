          "scene_number": 1,
          "timestamp_end": "0:01",
          "timestamp_start": "0:00"
        },
        {
          "audio": "No need to upload product images. I'll just paste the link for this pumpkin night light.",
          "label": "Product Information",
          "visual": "The cursor clicks inside the dialogue box. A URL for a pumpkin night light product is pasted into the box. The lighting is even and bright across the entire screen, giving a clear, professional look.",
