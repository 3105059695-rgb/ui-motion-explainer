      "scenes": [
        {
          "audio": "So has Gemini 4 regained its prestige?",
          "label": "Opening Hook",
          "visual": "Static camera shot centered on a minimalist white background. A multi-colored, four-pointed star icon with a blue-to-pink gradient sits above the central text. The lighting is flat and even across the frame, mimicking a digital interface. The background is a clean, sterile white with no visible texture.",
          "shot_type": "Wide Shot",
          "scene_number": 1,
          "timestamp_end": "0:02",
          "timestamp_start": "0:00"
        },
        {
          "audio": "I think there is both good and bad news.",
          "label": "Product Information",
          "visual": "A white rectangular card with soft rounded corners fades into the center of the frame. The card contains a list structure. The lighting remains even and digital. The color palette is restricted to white, light gray, and the small multi-colored icon in the top left corner of the card.",
          "shot_type": "Wide Shot",
          "scene_number": 2,
          "timestamp_end": "0:04",
          "timestamp_start": "0:02"
        },
        {
          "audio": "The front-end coding hasn't become stronger, and for game development...",
          "label": "Product Selling Points",
          "visual": "A vertical list of five items appears on the digital card. Circular indicators to the right of each item begin to fill with symbols: a black 'X' for the first item and a purple minus sign for the second. The animation is a clean, digital pop-in. The background remains white and static.",
          "shot_type": "Wide Shot",
          "scene_number": 3,
          "timestamp_end": "0:07",
          "timestamp_start": "0:04"
        },
        {
          "audio": "...it's still behind Claude and GPT. However, there is progress in writing and long-context tasks.",
          "label": "Product Selling Points",
          "visual": "The remaining items in the list fill in. The third and fourth items receive purple indicators, while the fifth item receives a green checkmark. Additional text elements appear at the bottom of the card. The camera movement is non-existent, focusing entirely on the digital interface updates.",
          "shot_type": "Wide Shot",
          "scene_number": 4,
          "timestamp_end": "0:12",
          "timestamp_start": "0:07"
        },
        {
          "audio": "But having said that...",
          "label": "Problem Solving",
          "visual": "The digital card and all list elements disappear, leaving a completely blank, solid white screen. The lighting is uniform and bright white.",
          "shot_type": "Wide Shot",
          "scene_number": 5,
          "timestamp_end": "0:13",
          "timestamp_start": "0:12"
        },
        {
          "audio": "...now Claude Code is banning accounts like crazy.",
          "label": "Usage Scenarios",
          "visual": "A new, smaller square white card with rounded corners appears on the left side of the screen. It features an orange sun-like or spark icon. The shot is static against the same white background. The lighting remains artificial and digital.",
          "shot_type": "Wide Shot",
          "scene_number": 6,
          "timestamp_end": "0:15",
          "timestamp_start": "0:13"
        }
