      "scenes": [
        {
          "audio": "A digital spinning sound effect, mimicking a slot machine or rapid counter, plays at a moderate tempo.",
          "label": "Opening Hook",
          "visual": "A static wide shot with a clean white background. Three identical vertical rectangular white cards with soft rounded corners are spaced evenly across the frame. Each card features a bold black title at the top: 'Astra', 'Sol', and 'Luna' from left to right. Below each name, large black numbers read '$0', '$0', and '$0.00' respectively. Lighting is flat, bright, and artificial, with no visible shadows.",
          "shot_type": "Wide Shot",
          "scene_number": 1,
          "timestamp_end": "0:01",
          "timestamp_start": "0:00"
        },
        {
          "audio": "A short, sharp 'ding' sound effect, similar to a digital notification bell, rings out once.",
          "label": "Product Information",
          "visual": "The camera remains static. The numbers on the three cards instantly update: Astra changes to '$10', Sol changes to '$2', and Luna changes to '$0.10'. The layout remains symmetrical and minimalist against the plain white background.",
          "shot_type": "Wide Shot",
          "scene_number": 2,
          "timestamp_end": "0:02",
          "timestamp_start": "0:01"
        },
        {
          "audio": "A soft, high-pitched 'pop' or bubble-clicking sound effect occurs as the text appears.",
          "label": "Product Selling Points",
          "visual": "Static camera shot. Bullet points with checkmark icons appear simultaneously at the bottom of all three cards. Below Astra, two lines of text appear. Below Sol, two lines appear. Below Luna, two lines appear. All elements are perfectly aligned and rendered in a clean, sans-serif black font.",
          "shot_type": "Wide Shot",
          "scene_number": 3,
          "timestamp_end": "0:03",
          "timestamp_start": "0:02"
        },
        {
          "audio": "A second soft 'pop' sound effect, identical to the previous one, triggers as the third line of text populates.",
          "label": "Product Selling Points",
          "visual": "Static camera shot. A third bullet point with a checkmark appears at the very bottom of each of the three cards. The spacing between the cards and the text remains consistent. The overall color palette remains strictly black, white, and gray.",
          "shot_type": "Wide Shot",
          "scene_number": 4,
          "timestamp_end": "0:04",
          "timestamp_start": "0:03"
        },
        {
          "audio": "A slightly louder, resonant 'ping' sound effect accompanies the color change and tag appearance.",
