      "scenes": [
        {
          "audio": "Fast-paced, high-frequency digital clicking sounds resembling a rapid-fire mechanical shutter or a card shuffling effect. No speech.",
          "label": "Opening Hook",
          "visual": "A white digital environment where four rectangular cards with rounded corners are floating in 3D space. The cards are fanned out and rotating slightly. One card shows a photo of three men in a modern office: the leftmost man is middle-aged with dark hair in a suit, the middle man is younger with dark hair and a casual jacket, and the rightmost man is seated with grey hair and a blue sweater. The cards feature high-contrast color blocks in black, dark blue, and emerald green. The lighting is uniform and bright across the entire frame, creating a clean tech aesthetic.",
          "shot_type": "Wide Shot",
          "scene_number": 1,
          "timestamp_end": "0:01",
          "timestamp_start": "0:00"
        },
        {
          "audio": "Two distinct, resonant digital 'thud' or 'pop' sounds that sync with the cards disappearing and the final card locking into center frame. No speech.",
          "label": "Product Information",
          "visual": "The camera quickly zooms in on a single emerald green and grey card as the other cards fall away. The card features a black and white portrait of an elderly man with a very long white beard, wearing a formal 19th-century dark suit and bowtie, seated in an ornate wooden chair. The background of the card is a solid emerald green. The lighting is flat and digital, with the card centered perfectly in the white void.",
          "shot_type": "Medium Shot",
          "scene_number": 2,
