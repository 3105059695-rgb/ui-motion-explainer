      "scenes": [
        {
          "audio": "I think the problem is that it wants to please you too much.",
          "label": "Opening Hook",
          "visual": "A clean, minimalist white digital canvas serves as the background. Centrally aligned are two floating text blocks with soft drop shadows. The lighting is perfectly even and digital, simulating a studio aesthetic. No human subjects are present. The camera is static.",
          "shot_type": "Wide Shot",
          "scene_number": 1,
          "timestamp_end": "0:02",
          "timestamp_start": "0:00"
        },
        {
          "audio": "It's like an intern who is trying exceptionally hard.",
          "label": "Product Information",
          "visual": "A white card with rounded corners, featuring a four-pointed star logo in blue, yellow, and red colors, slides into the left side of the frame. The card is centered vertically. The background remains a sterile, high-key white environment with soft lighting.",
          "shot_type": "Medium Shot",
          "scene_number": 2,
          "timestamp_end": "0:04",
          "timestamp_start": "0:02"
        },
        {
          "audio": "You tell it to make a homepage for you.",
          "label": "Usage Scenarios",
          "visual": "To the right of the previous card, a larger white rectangular interface window appears. A speech bubble-like element pops up above it. The composition is balanced and follows a grid layout. The colors are neutral with high saturation only on the small logo icon.",
          "shot_type": "Wide Shot",
          "scene_number": 3,
          "timestamp_end": "0:06",
          "timestamp_start": "0:04"
        },
        {
          "audio": "It can't wait to pile all the materials and data onto it.",
          "label": "Problem Solving",
          "visual": "Multiple dark grey and black rounded buttons with varying widths rapidly populate the white interface window on the right. They appear in a staggered, chaotic fashion, filling the empty space. The camera remains static and the lighting is flat digital lighting.",
          "shot_type": "Medium Shot",
          "scene_number": 4,
          "timestamp_end": "0:08",
          "timestamp_start": "0:06"
        },
        {
          "audio": "The functionality is there, but the aesthetics haven't caught up yet.",
          "label": "Product Selling Points",
          "visual": "The interface window on the left fills with buttons, while on the right side of the screen, two progress bars appear. The top bar fills to the end with a black indicator, while the bottom bar remains mostly empty with a grey indicator. The background is pure white.",
          "shot_type": "Medium Shot",
          "scene_number": 5,
          "timestamp_end": "0:10",
          "timestamp_start": "0:08"
        }
      ]
    },
